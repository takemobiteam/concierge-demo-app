.metadata

# .env.json / .env.local.json hold real dev-define values (e.g. a personal
# ngrok URL) and are gitignored. The *.example files show the expected shape
# with placeholder values and are checked in — copy and rename to use.
.env
.env.*
!.env.json.example
!.env.local.json.example
*.pem
